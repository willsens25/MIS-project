{
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/*.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/gemini/stream",
      "destination": "/api/gemini/stream"
    },
    {
      "source": "/api/gemini",
      "destination": "/api/gemini"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}